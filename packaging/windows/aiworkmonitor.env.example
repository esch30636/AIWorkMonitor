# Copy this file beside AIWorkMonitorAgent.exe as aiworkmonitor.env.
AIWM_TOKEN=replace-with-a-long-random-token
AIWM_RELAY_URL=ws://192.168.1.20:8765
AIWM_DEVICE_NAME=windows-main
AIWM_SAMPLE_INTERVAL=2

# Claude sessions and project paths are discovered automatically from ~/.claude/projects.
# Remote Claude commands are disabled unless explicitly enabled.
AIWM_ALLOW_CLAUDE_COMMANDS=false

# Optional overrides:
# AIWM_DEVICE_ID=windows-main-id
# AIWM_CLAUDE_LOG_GLOB=C:\Users\you\.claude\projects\**\*.jsonl
# AIWM_CHATGPT_LOG_GLOB=C:\path\to\chatgpt\*.jsonl
